{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murm.dev/schemas/kinds/publication-v1.schema.json",
  "title": "Murm Publication Event Version 1",
  "allOf": [
    {
      "$ref": "../event-v1.schema.json"
    },
    {
      "properties": {
        "kind": {
          "const": 1
        },
        "header": {
          "type": "object",
          "required": [
            "document",
            "revision",
            "previous"
          ],
          "properties": {
            "document": {
              "$ref": "../event-v1.schema.json#/$defs/hex32"
            },
            "revision": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "previous": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "$ref": "../event-v1.schema.json#/$defs/hex32"
                }
              ]
            },
            "title": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "summary": {
              "type": "string",
              "maxLength": 500
            },
            "topics": {
              "type": "array",
              "maxItems": 20,
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 64
              }
            },
            "language": {
              "type": "string",
              "$comment": "Validated semantically as a well-formed BCP 47 language tag under RFC 5646 Section 2.1."
            }
          },
          "additionalProperties": false
        },
        "content": {
          "type": "string"
        }
      }
    }
  ]
}
