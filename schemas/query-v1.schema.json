{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murm.dev/schemas/query-v1.schema.json",
  "title": "Murm Event Query Version 1",
  "type": "object",
  "required": [
    "where"
  ],
  "properties": {
    "where": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "$ref": "#/$defs/queryGroup"
      }
    },
    "sort": {
      "type": "array",
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sortField"
      }
    },
    "limit": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100,
      "default": 20
    },
    "cursor": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        }
      ],
      "default": null
    }
  },
  "additionalProperties": false,
  "$defs": {
    "jsonPointer": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(?:/(?:[^~/]|~[01])*)+$"
    },
    "queryGroup": {
      "type": "object",
      "required": [
        "all"
      ],
      "properties": {
        "all": {
          "type": "array",
          "minItems": 1,
          "maxItems": 20,
          "items": {
            "$ref": "#/$defs/queryCondition"
          }
        }
      },
      "additionalProperties": false
    },
    "queryCondition": {
      "type": "object",
      "required": [
        "path",
        "op",
        "value"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "op": {
          "enum": [
            "eq",
            "in",
            "contains",
            "exists",
            "gte",
            "lte"
          ]
        },
        "value": true
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "exists"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "boolean"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "const": "in"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "array",
                "minItems": 1,
                "maxItems": 100
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "op": {
                "enum": [
                  "gte",
                  "lte"
                ]
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "value": {
                "type": "number"
              }
            }
          }
        }
      ]
    },
    "sortField": {
      "type": "object",
      "required": [
        "path",
        "direction"
      ],
      "properties": {
        "path": {
          "$ref": "#/$defs/jsonPointer"
        },
        "direction": {
          "enum": [
            "asc",
            "desc"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
