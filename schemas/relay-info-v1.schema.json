{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://murm.dev/schemas/relay-info-v1.schema.json",
  "title": "Murm Relay Information Version 1",
  "type": "object",
  "required": [
    "protocol",
    "versions",
    "mips",
    "limits",
    "features"
  ],
  "properties": {
    "protocol": {
      "const": "murm"
    },
    "versions": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    },
    "mips": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "integer",
        "minimum": 0
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "event_bytes",
        "batch_events",
        "query_conditions",
        "query_groups",
        "query_limit"
      ],
      "properties": {
        "event_bytes": {
          "const": 2097152
        },
        "batch_events": {
          "type": "integer",
          "minimum": 1
        },
        "query_conditions": {
          "const": 20
        },
        "query_groups": {
          "const": 10
        },
        "query_limit": {
          "const": 100
        }
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "features": {
      "type": "object",
      "required": [
        "http_query",
        "post_query_fallback"
      ],
      "properties": {
        "http_query": {
          "const": true
        },
        "post_query_fallback": {
          "const": true
        }
      },
      "additionalProperties": {
        "type": [
          "boolean",
          "number",
          "string",
          "null"
        ]
      }
    }
  },
  "additionalProperties": false
}
